{
  "name": "urban-shopy-server",
  "version": "1.0.0",
  "private": true,
  "description": "Urban Shopy - Express + MongoDB backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc src/server.ts --outDir dist --rootDir src --target ES2020 --module commonjs --lib ES2020 --types node,express,cors,morgan,bcryptjs,jsonwebtoken --esModuleInterop --skipLibCheck --resolveJsonModule --allowSyntheticDefaultImports --forceConsistentCasingInFileNames",
    "start": "node dist/server.js",
    "seed": "ts-node-dev --transpile-only src/seed/seed.ts",
    "lint": "tsc --noEmit src/server.ts --target ES2020 --module commonjs --lib ES2020 --types node,express,cors,morgan,bcryptjs,jsonwebtoken --skipLibCheck --esModuleInterop --resolveJsonModule --allowSyntheticDefaultImports"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}